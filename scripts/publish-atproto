#!/usr/bin/env node
// Publish this repo's pieces/ as atproto site.standard.* records.
//
// Record shapes reuse decant / sequoia's `site.standard.publication` and
// `site.standard.document` (see decant packages). The site.standard.* lexicon
// uses TID record keys, so the PDS assigns each rkey on first write; this script
// then owns the publish policy the migration brief requires:
//   - one publication record, idempotent (reuses its ledger-stored rkey)
//   - one document per piece, upserted on change (create once, then putRecord to
//     the same rkey) — idempotent
//   - records that leave pieces/ are DELETED from the PDS
//   - a committed records.json ledger (slug -> at-uri, cid) so the slug↔record
//     mapping is inspectable in git even though the rkey itself is a TID
//
// Credentials via env: ATP_IDENTIFIER, ATP_APP_PASSWORD, ATP_PDS_URL.
// Run `node scripts/publish-atproto --dry-run` to compute the plan without
// touching the network or needing credentials.

import { readFileSync, writeFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { parse } from './lib/frontmatter.mjs';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const PIECES = join(ROOT, 'pieces');
const LEDGER = join(ROOT, 'records.json');

// ---- publication identity (the site this repo feeds) -----------------------
const SITE_URL = 'https://maxine.science';
const PUBLICATION_NAME = 'maxine.science';
const COL_PUB = 'site.standard.publication';
const COL_DOC = 'site.standard.document';

const DRY_RUN = process.argv.includes('--dry-run');

// ---- helpers ---------------------------------------------------------------
const sha256 = (s) => createHash('sha256').update(s).digest('hex');

// deterministic JSON (sorted keys) so a record's hash is stable across runs and
// changes whenever the record's shape or content changes.
function stableStringify(o) {
  if (Array.isArray(o)) return '[' + o.map(stableStringify).join(',') + ']';
  if (o && typeof o === 'object') {
    return '{' + Object.keys(o).sort().map((k) => JSON.stringify(k) + ':' + stableStringify(o[k])).join(',') + '}';
  }
  return JSON.stringify(o);
}

function loadJSON(name, fallback) {
  const p = join(ROOT, name);
  if (existsSync(p)) return JSON.parse(readFileSync(p, 'utf8'));
  return fallback;
}

function loadLedger() {
  if (existsSync(LEDGER)) return JSON.parse(readFileSync(LEDGER, 'utf8'));
  return { publication: null, documents: {} };
}
function saveLedger(l) {
  // stable key order for clean diffs
  const documents = {};
  for (const k of Object.keys(l.documents).sort()) documents[k] = l.documents[k];
  writeFileSync(LEDGER, JSON.stringify({ publication: l.publication, documents }, null, 2) + '\n');
}

function listSlugs() {
  return readdirSync(PIECES)
    .filter((n) => { try { return statSync(join(PIECES, n, 'index.md')).isFile(); } catch { return false; } })
    .sort();
}

// Reduce markdown body to plain text for the record's textContent field.
function stripMarkdown(md) {
  return md
    .replace(/```[\s\S]*?```/g, ' ')          // fenced code
    .replace(/`([^`]+)`/g, '$1')               // inline code
    .replace(/^<!--[\s\S]*?-->/gm, ' ')        // html comments
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')     // images
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')   // links -> text
    .replace(/^\s{0,3}#{1,6}\s+/gm, '')        // headings
    .replace(/^\s{0,3}>\s?/gm, '')             // blockquotes
    .replace(/^\s{0,3}([-*_])\s*\1\s*\1[\s\S]*?$/gm, ' ') // hr / ***
    .replace(/\*\*([^*]+)\*\*/g, '$1')         // bold
    .replace(/([*_])([^*_]+)\1/g, '$2')        // italic
    .replace(/~~([^~]+)~~/g, '$1')             // strikethrough
    .replace(/\s+/g, ' ')
    .trim();
}

function buildDocRecord(slug, fm, publicationUri, personas) {
  const d = fm.data;
  // path + site are what consumers use to build the canonical URL (per the
  // site.standard lexicon); we do not emit a separate canonicalUrl.
  const path = new URL(d.canonical).pathname;   // /writing/<slug> or /dialogues/<slug>
  const rec = {
    $type: COL_DOC,
    title: d.title,
    site: publicationUri,
    path,
    textContent: stripMarkdown(fm.body),
    publishedAt: new Date(`${d.date}T00:00:00.000Z`).toISOString(),
  };
  if (d.updated) rec.updatedAt = new Date(`${d.updated}T00:00:00.000Z`).toISOString();
  const description = d.summary || d.subtitle;
  if (description) rec.description = description;
  if (Array.isArray(d.tags) && d.tags.length) rec.tags = d.tags;
  // contributors: resolve persona keys -> {did, role?, displayName?}
  if (Array.isArray(d.contributors) && d.contributors.length) {
    rec.contributors = d.contributors.map((key) => {
      const p = personas[key];
      if (!p || !p.did) throw new Error(`${slug}: unknown/incomplete contributor persona "${key}"`);
      const c = { did: p.did };
      if (p.role) c.role = p.role;
      if (p.displayName) c.displayName = p.displayName;
      return c;
    });
  }
  return rec;
}

// ---- main ------------------------------------------------------------------
async function main() {
  const ledger = loadLedger();
  const slugs = listSlugs();
  const pubMeta = loadJSON('publication.json', {});
  const personas = loadJSON('personas.json', {});

  // Parse each piece's frontmatter+body once.
  const desired = {};
  for (const slug of slugs) {
    const raw = readFileSync(join(PIECES, slug, 'index.md'), 'utf8');
    desired[slug] = { fm: parse(raw) };
  }

  let agent = null;
  if (!DRY_RUN) {
    // trim: secrets pasted on mobile often carry a trailing newline/space,
    // which the PDS rejects as an invalid identifier/password.
    const identifier = process.env.ATP_IDENTIFIER?.trim();
    const password = process.env.ATP_APP_PASSWORD?.trim();
    const service = (process.env.ATP_PDS_URL || 'https://bsky.social').trim();
    if (!identifier || !password) {
      console.error('Set ATP_IDENTIFIER and ATP_APP_PASSWORD (and optionally ATP_PDS_URL).');
      process.exit(2);
    }
    const { AtpAgent } = await import('@atproto/api');
    agent = new AtpAgent({ service });
    await agent.login({ identifier, password });
  }

  // The site.standard.* lexicon uses TID record keys, so the PDS assigns the
  // rkey on first write (createRecord). We keep the slug -> at-uri mapping in
  // records.json and reuse each record's own rkey for updates/deletes, which is
  // what makes publishing idempotent and the mapping inspectable in git.
  const rkeyOf = (uri) => uri.split('/').pop();
  const create = async (collection, record) => {
    if (DRY_RUN) { console.log(`  CREATE ${collection} (server-assigned tid)`); return { uri: `at://DRY/${collection}/DRYTID`, cid: 'DRY' }; }
    const res = await agent.com.atproto.repo.createRecord({ repo: agent.did, collection, record });
    return { uri: res.data.uri, cid: res.data.cid };
  };
  const put = async (collection, rkey, record) => {
    if (DRY_RUN) { console.log(`  PUT    ${collection}/${rkey}`); return { uri: `at://DRY/${collection}/${rkey}`, cid: 'DRY' }; }
    const res = await agent.com.atproto.repo.putRecord({ repo: agent.did, collection, rkey, record });
    return { uri: res.data.uri, cid: res.data.cid };
  };
  const del = async (collection, rkey) => {
    if (DRY_RUN) { console.log(`  DEL    ${collection}/${rkey}`); return; }
    await agent.com.atproto.repo.deleteRecord({ repo: agent.did, collection, rkey });
  };

  // Fetch the site's generated OG image for a piece and upload it as a blob.
  // Returns a blob ref object, or null if the image isn't available yet (a new
  // piece's OG only exists after the site rebuilds) or is too large.
  const COVER_MAX = 1024 * 1024 - 1;
  const ogBase = pubMeta.url || SITE_URL;
  const fetchCover = async (path) => {
    if (DRY_RUN) return null;
    const url = `${ogBase}/og${path}.png`;
    try {
      const res = await fetch(url);
      if (!res.ok) return null;
      const buf = Buffer.from(await res.arrayBuffer());
      if (buf.length > COVER_MAX || buf.length === 0) return null;
      const up = await agent.com.atproto.repo.uploadBlob(buf, { encoding: 'image/png' });
      const b = up.data.blob;
      return { $type: 'blob', ref: { $link: b.ref.toString() }, mimeType: b.mimeType, size: b.size };
    } catch {
      return null; // never fail the whole publish over a cover image
    }
  };

  // 1. Publication record (metadata from publication.json; idempotent via the
  //    ledger's stored rkey; preserve the original createdAt once set).
  const createdAt = ledger.publication?.createdAt || new Date().toISOString();
  const pubRecord = {
    $type: COL_PUB,
    url: pubMeta.url || SITE_URL,
    name: pubMeta.name || PUBLICATION_NAME,
    createdAt,
    preferences: { showInDiscover: pubMeta.showInDiscover ?? false },
  };
  if (pubMeta.description) pubRecord.description = pubMeta.description;
  const pub = ledger.publication?.uri
    ? await put(COL_PUB, rkeyOf(ledger.publication.uri), pubRecord)
    : await create(COL_PUB, pubRecord);
  const publicationUri = pub.uri;
  ledger.publication = { uri: pub.uri, cid: pub.cid, createdAt };

  // 2. Upsert documents whose built record changed (hashing the record, not the
  //    source file, so record-shape changes and backfilled coverImages propagate).
  let created = 0, updated = 0, skipped = 0, deleted = 0;
  for (const slug of slugs) {
    const prev = ledger.documents[slug];
    const { fm } = desired[slug];
    const record = buildDocRecord(slug, fm, publicationUri, personas);

    // coverImage: reuse the ledger's blob if we already have one; otherwise try
    // to fetch the site's generated OG image and upload it. A new piece's OG
    // doesn't exist until the site rebuilds, so a miss is fine — it backfills on
    // a later run.
    let cover = prev?.coverImage;
    if (!cover) cover = await fetchCover(record.path);
    if (cover) record.coverImage = cover;

    const recordHash = sha256(stableStringify(record));
    if (prev && prev.uri && prev.recordHash === recordHash) {
      skipped++;
      continue;
    }
    const { uri, cid } = prev?.uri
      ? await put(COL_DOC, rkeyOf(prev.uri), record)
      : await create(COL_DOC, record);
    ledger.documents[slug] = { slug, uri, cid, recordHash, coverImage: cover, site: publicationUri };
    if (prev) updated++; else created++;
  }

  // 3. Delete records for pieces that left pieces/.
  for (const slug of Object.keys(ledger.documents)) {
    if (!desired[slug]) {
      await del(COL_DOC, rkeyOf(ledger.documents[slug].uri));
      delete ledger.documents[slug];
      deleted++;
    }
  }

  saveLedger(ledger);
  console.log(`publish-atproto${DRY_RUN ? ' (dry-run)' : ''}: publication ${publicationUri}`);
  console.log(`  documents: ${created} created, ${updated} updated, ${skipped} unchanged, ${deleted} deleted`);
}

main().catch((e) => { console.error(e); process.exit(1); });
