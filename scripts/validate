#!/usr/bin/env node
// The only gate on publishing. Validates every pieces/<slug>/index.md against
// the frontmatter schema documented in SCHEMA.md. Exits non-zero on any
// violation so CI (.github/workflows/validate.yml) fails the build.
//
// Dependency-free: standard Node only.

import { readdirSync, readFileSync, statSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parse } from './lib/frontmatter.mjs';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const PIECES = join(ROOT, 'pieces');

const KINDS = new Set(['essay', 'fiction', 'note', 'dialogue']);
const ALLOWED = new Set([
  'title', 'subtitle', 'date', 'updated', 'kind',
  'coauthor', 'formerName', 'summary', 'canonical', 'tags', 'contributors',
]);
const REQUIRED = ['title', 'date', 'kind', 'canonical'];
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
const SITE = 'https://maxine.science';
const TAG_MAX = 128; // site.standard.document tags: maxGraphemes 128

// persona registry: contributors reference these keys (each maps to a DID).
let PERSONAS = {};
try { PERSONAS = JSON.parse(readFileSync(join(ROOT, 'personas.json'), 'utf8')); } catch {}

let errors = 0;
const fail = (slug, msg) => { errors++; console.error(`  ✗ ${slug}: ${msg}`); };

function isRealDate(s) {
  if (!DATE_RE.test(s)) return false;
  const [y, m, d] = s.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}

let slugs;
try {
  slugs = readdirSync(PIECES).filter((n) => {
    try { return statSync(join(PIECES, n)).isDirectory(); } catch { return false; }
  }).sort();
} catch {
  console.error('no pieces/ directory found');
  process.exit(1);
}

for (const slug of slugs) {
  const file = join(PIECES, slug, 'index.md');
  let raw;
  try { raw = readFileSync(file, 'utf8'); }
  catch { fail(slug, `missing ${slug}/index.md`); continue; }

  let fm;
  try { fm = parse(raw); }
  catch (e) { fail(slug, e.message); continue; }
  if (!fm.data) { fail(slug, 'no frontmatter block'); continue; }
  const d = fm.data;

  for (const k of REQUIRED) {
    if (!(k in d) || d[k] === '') fail(slug, `missing required field: ${k}`);
  }
  for (const k of Object.keys(d)) {
    if (!ALLOWED.has(k)) fail(slug, `unknown field: ${k}`);
  }

  if (d.date && !isRealDate(d.date)) fail(slug, `date must be a real YYYY-MM-DD (got "${d.date}")`);
  if (d.updated && !isRealDate(d.updated)) fail(slug, `updated must be a real YYYY-MM-DD (got "${d.updated}")`);

  if (d.kind && !KINDS.has(d.kind)) fail(slug, `kind must be one of ${[...KINDS].join(', ')} (got "${d.kind}")`);

  // canonical must resolve to the site path implied by kind and equal the slug
  if (d.canonical) {
    const seg = d.kind === 'dialogue' ? 'dialogues' : 'writing';
    const want = `${SITE}/${seg}/${slug}`;
    if (d.canonical !== want) fail(slug, `canonical must be ${want} (got "${d.canonical}")`);
  }

  // register consistency: dialogues carry a coauthor; the rest do not.
  if (d.kind === 'dialogue' && !d.coauthor) fail(slug, 'kind: dialogue requires a coauthor');
  if (d.kind && d.kind !== 'dialogue' && d.coauthor) fail(slug, `coauthor is only for kind: dialogue (got kind: ${d.kind})`);

  // tags: optional list of non-empty strings within the lexicon length bound
  if ('tags' in d) {
    if (!Array.isArray(d.tags)) fail(slug, 'tags must be a list, e.g. [foo, bar]');
    else for (const t of d.tags) {
      if (typeof t !== 'string' || t === '') fail(slug, 'tags entries must be non-empty strings');
      else if (t.length > TAG_MAX) fail(slug, `tag too long (>${TAG_MAX}): "${t}"`);
    }
  }

  // contributors: optional list of persona keys that must exist in personas.json
  if ('contributors' in d) {
    if (!Array.isArray(d.contributors)) fail(slug, 'contributors must be a list of persona keys');
    else for (const c of d.contributors) {
      if (!PERSONAS[c]) fail(slug, `unknown contributor persona: "${c}" (add it to personas.json)`);
      else if (!PERSONAS[c].did) fail(slug, `persona "${c}" has no did in personas.json`);
    }
  }
}

if (errors) {
  console.error(`\nvalidate: ${errors} error(s) across ${slugs.length} piece(s)`);
  process.exit(1);
}
console.log(`validate: ${slugs.length} piece(s) OK`);
